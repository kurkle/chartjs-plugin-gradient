{
  "author": "Jukka Kurkela <jukka.kurkela@gmail.com>",
  "bugs": {
    "url": "https://github.com/kurkle/chartjs-plugin-gradient/issues"
  },
  "description": "Easy gradient colors for Chart.js",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/starlight": "^0.42.0",
    "@biomejs/biome": "^2.4.14",
    "@kurkle/astro-chartjs-editor": "^1.0.0",
    "@kurkle/configs": "^1.5.1",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "astro": "^7.0.6",
    "chart.js": "^4.0.1",
    "chartjs-adapter-luxon": "^1.3.0",
    "fs-extra": "^11.1.0",
    "luxon": "^3.1.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "rollup": "^4.54.0",
    "semantic-release": "^25.0.3",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/chartjs-plugin-gradient.esm.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/chartjs-plugin-gradient.cjs"
      },
      "script": "./dist/chartjs-plugin-gradient.min.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*",
    "!dist/docs/**",
    "types/*.d.ts",
    "types/*.d.cts"
  ],
  "homepage": "https://github.com/kurkle/chartjs-plugin-gradient#readme",
  "jsdelivr": "dist/chartjs-plugin-gradient.min.js",
  "keywords": [
    "chart.js",
    "plugin",
    "color",
    "palette",
    "generator",
    "auto"
  ],
  "license": "MIT",
  "main": "dist/chartjs-plugin-gradient.cjs",
  "module": "dist/chartjs-plugin-gradient.esm.js",
  "name": "chartjs-plugin-gradient",
  "peerDependencies": {
    "chart.js": ">=2.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurkle/chartjs-plugin-gradient.git"
  },
  "scripts": {
    "build": "rollup -c && kurkle-build-cjs-types --dir types",
    "dev": "vitest --config vitest.browser.config.ts",
    "docs": "npm run build && astro build",
    "docs:dev": "npm run build && astro dev",
    "docs:version": "node ./docs/scripts/write-docs-version.cjs",
    "fixtures:update": "node scripts/update-fixtures.mjs",
    "format": "biome check --write",
    "icons": "kurkle-generate-icons",
    "lint": "biome check",
    "predocs": "npm run docs:version",
    "predocs:dev": "npm run docs:version",
    "prepack": "npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "npm run test:fixture && npm run test:integration:min-bundle && npm run test:pack",
    "test:fixture": "vitest run --config vitest.browser.config.ts --coverage",
    "test:integration:min-bundle": "vitest run --config vitest.integration.config.ts",
    "test:pack": "kurkle-check-package",
    "typecheck": "tsc --noEmit -p tsconfig.tooling.json && tsc --noEmit -p test/types/",
    "typecheck:docs": "astro check"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./types/index.d.cts",
  "unpkg": "dist/chartjs-plugin-gradient.min.js",
  "version": "0.0.0-development"
}
