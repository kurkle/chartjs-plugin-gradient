{
  "extends": ["./node_modules/@kurkle/configs/biome.json"],
  "files": {
    "includes": [
      "astro.config.mjs",
      "biome.json",
      "docs/chart-runtime.js",
      "docs/scripts/**/*.js",
      "docs/scripts/**/*.cjs",
      "docs/styles/**/*.css",
      "package.json",
      "rollup.config.js",
      "scripts/**/*.mjs",
      "src/**/*.js",
      "src/**/*.ts",
      "test/fixtures/**/*.js",
      "test/integration/**/*.js",
      "test/setup.js",
      "test/specs/**/*.js",
      "test/utils/**/*.js",
      "tsconfig.tooling.json",
      "types/**/*.ts",
      "vitest.browser.config.ts",
      "vitest.integration.config.ts"
    ]
  },
  "overrides": [
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      },
      "includes": ["package.json"]
    }
  ]
}
